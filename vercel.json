{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py?_route=/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{ahg_pos/**,schema/**}",
      "excludeFiles": "{tests/**,output/**,tmp/**,docs/**,.venv/**,data/**,**/*.db,**/*.sqlite}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/integrations",
      "schedule": "15 11 * * *"
    }
  ]
}
